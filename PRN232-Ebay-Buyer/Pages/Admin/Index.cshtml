@page
@model PRN232_Ebay_Buyer.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Dashboard Overview";
    ViewData["ActivePage"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background: linear-gradient(135deg, #f8f9fa, #e9ecef);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted mb-2">Total Users</h6>
                    <h2 class="mb-0 fw-bold">@Model.Stats?.TotalUsers</h2>
                </div>
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-people fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background: linear-gradient(135deg, #f8f9fa, #e9ecef);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted mb-2">Total Products</h6>
                    <h2 class="mb-0 fw-bold">@Model.Stats?.TotalProducts</h2>
                </div>
                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background: linear-gradient(135deg, #f8f9fa, #e9ecef);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted mb-2">Total Orders</h6>
                    <h2 class="mb-0 fw-bold">@Model.Stats?.TotalOrders</h2>
                </div>
                <div class="bg-warning text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-cart3 fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3" style="background: linear-gradient(135deg, #f8f9fa, #e9ecef);">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted mb-2">Total Revenue</h6>
                    <h2 class="mb-0 fw-bold">$@(Model.Stats?.TotalRevenue.ToString("N2"))</h2>
                </div>
                <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-currency-dollar fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
        <h5 class="fw-bold mb-0">Recent Orders</h5>
    </div>
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="border-0 rounded-start">Order ID</th>
                        <th class="border-0">Buyer</th>
                        <th class="border-0">Date</th>
                        <th class="border-0">Total Price</th>
                        <th class="border-0 rounded-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentOrders.Any())
                    {
                        foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td><span class="fw-semibold text-primary">#@order.OrderId</span></td>
                                <td>@order.BuyerName</td>
                                <td>@(order.OrderDate?.ToString("MMM dd, yyyy HH:mm") ?? "-")</td>
                                <td><span class="fw-semibold">$@order.TotalPrice.ToString("N2")</span></td>
                                <td>
                                    @{
                                        var badgeClass = order.Status switch
                                        {
                                            "Delivered" => "bg-success",
                                            "Shipped" => "bg-info",
                                            "Pending" => "bg-warning text-dark",
                                            "Cancelled" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass rounded-pill px-3 py-2">@order.Status</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No recent orders found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
